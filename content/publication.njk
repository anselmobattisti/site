---js
{
	eleventyNavigation: {
		key: "Publications",
		parent: "Research",
		order: 1,	
	},
	title: "Publications — Anselmo Luiz Éden Battisti",
	description: "Peer-reviewed journal articles and conference papers by Anselmo Luiz Éden Battisti on SFC placement, VNF placement, edge computing, 5G and the Internet of Media Things." 
}
---
<div class="hero">
	<p class="eyebrow">{{ collections.publications | length }} peer-reviewed papers · 2014 — {{ (collections.publications | last).data.year }}</p>
	<h1>Publications</h1>
	<p class="lede">Journal articles and conference papers written with co-authors from UFF, UFRN and Dell Research, newest first. PDFs, slides and video recordings are linked where available.</p>
</div>

{% set publicationslist = collections.publications %}
{% set publicationslistFilter = true %}
{% include "publicationslist.njk" %}

<script type="text/javascript" eleventy:ignore>
(function () {
  var chips = document.querySelectorAll('.filters .chip');
  var list = document.getElementById('publication-list');
  if (!chips.length || !list) return;

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var wanted = chip.dataset.filter;
      chips.forEach(function (other) {
        other.setAttribute('aria-pressed', String(other === chip));
      });
      list.querySelectorAll('.entry').forEach(function (entry) {
        entry.hidden = !(wanted === 'all' || entry.dataset.type === wanted);
      });
    });
  });
})();
</script>
