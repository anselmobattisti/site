---
layout: layouts/base.njk
---
{#- A side project from the Extra section. Same skeleton as project.njk, with
    the facts a hobby build has (platform, stack) in place of the ones a
    research project has (institution, funding, students). -#}
<article>
  <div class="hero">
    <p class="eyebrow">Extra{% if period %} · {{ period }}{% endif %}</p>
    <h1>{{ title }}</h1>
    {%- if summary %}
    <p class="lede">{{ summary }}</p>
    {%- endif %}

    {%- if repo_link or site_link %}
    <div class="hero-actions">
      {%- if site_link %}<a class="btn btn-solid" href="{{ site_link }}" target="_blank" rel="noopener">Project site</a>{% endif %}
      {%- if repo_link %}<a class="btn{% if not site_link %} btn-solid{% endif %}" href="{{ repo_link }}" target="_blank" rel="noopener">Source code</a>{% endif %}
    </div>
    {%- endif %}
  </div>

  <ul class="publication-facts">
    {%- if period %}
    <li><span class="k">Year</span><span>{{ period }}</span></li>
    {%- endif %}
    {%- if status %}
    <li><span class="k">Status</span><span class="lang-tag">{{ status }}</span></li>
    {%- endif %}
    {%- if platform %}
    <li><span class="k">Platform</span><span>{{ platform }}</span></li>
    {%- endif %}
    {%- if built_with %}
    <li><span class="k">Built with</span><span>{{ built_with }}</span></li>
    {%- endif %}
    {%- if made_with %}
    <li><span class="k">Made with</span><span>{{ made_with }}</span></li>
    {%- endif %}
    {#- The hero buttons are hidden in print, so the addresses only survive
        onto paper if they are spelled out here. -#}
    {%- if site_link %}
    <li><span class="k">Website</span><span><a href="{{ site_link }}" target="_blank" rel="noopener">{{ site_link | displayUrl }}</a></span></li>
    {%- endif %}
    {%- if repo_link %}
    <li><span class="k">Source</span><span><a href="{{ repo_link }}" target="_blank" rel="noopener">{{ repo_link | displayUrl }}</a></span></li>
    {%- endif %}
  </ul>

  {%- if abstract %}
  <div class="abstract">
    <h2>About</h2>
    <p>{{ abstract }}</p>
  </div>
  {%- endif %}

  <div class="section prose">
    {{ content | safe }}
  </div>

  {%- set previousExtra = collections.extra | getPreviousCollectionItem %}
  {%- set nextExtra = collections.extra | getNextCollectionItem %}
  {%- if nextExtra or previousExtra %}
  <ul class="links-nextprev">
    {%- if previousExtra %}<li class="links-nextprev-prev">← Earlier<br><a href="{{ previousExtra.url }}">{{ previousExtra.data.title }}</a></li>{% endif %}
    {%- if nextExtra %}<li class="links-nextprev-next">Later →<br><a href="{{ nextExtra.url }}">{{ nextExtra.data.title }}</a></li>{% endif %}
  </ul>
  {%- endif %}
</article>
