---
layout: layouts/base.njk
---
<article>
  <div class="hero">
    <p class="eyebrow">{{ tags | publicationKind }} · {{ event_magazine }} · {{ year }}</p>
    <h1>{{ title }}</h1>
    {%- if authors %}
    <p class="lede">{{ authors | highlightAuthor | safe }}</p>
    {%- endif %}

    <div class="hero-actions">
      {%- if pdf_link %}<a class="btn btn-solid" href="{{ pdf_link }}" target="_blank" rel="noopener">Read the paper (PDF)</a>{% endif %}
      {%- if presentation_link %}<a class="btn" href="{{ presentation_link }}" target="_blank" rel="noopener">Presentation slides</a>{% endif %}
      {%- if video_link %}<a class="btn" href="{{ video_link }}" target="_blank" rel="noopener">Watch the talk</a>{% endif %}
      {%- if doi %}<a class="btn" href="https://doi.org/{{ doi }}" target="_blank" rel="noopener">DOI</a>{% endif %}
    </div>
  </div>

  <ul class="publication-facts">
    <li><span class="k">Venue</span><span>{{ event_magazine }}</span></li>
    <li><span class="k">Year</span><span>{{ year }}</span></li>
    <li><span class="k">Type</span><span>{{ tags | publicationKind }}</span></li>
    {%- if doi %}
    <li><span class="k">DOI</span><span><a href="https://doi.org/{{ doi }}" target="_blank" rel="noopener">{{ doi }}</a></span></li>
    {%- endif %}
  </ul>

  {%- if abstract %}
  <div class="abstract">
    <h2>Abstract</h2>
    <p>{{ abstract }}</p>
  </div>
  {%- endif %}

  <div class="section prose">
    {{ content | safe }}
  </div>

  {%- set previousPost = collections.publications | getPreviousCollectionItem %}
  {%- set nextPost = collections.publications | getNextCollectionItem %}
  {%- if nextPost or previousPost %}
  <ul class="links-nextprev">
    {%- if previousPost %}<li class="links-nextprev-prev">← Earlier<br><a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
    {%- if nextPost %}<li class="links-nextprev-next">Later →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
  </ul>
  {%- endif %}
</article>
