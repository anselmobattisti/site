---
// Página de um projeto paralelo. Mesmo esqueleto do projeto de pesquisa, com os dados de um projeto de lazer
// (plataforma, com o que foi feito) no lugar dos de pesquisa (instituição, financiamento, alunos).
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AnteriorProximo from '../../components/AnteriorProximo.astro';
import { itens, resumir, urlCurta } from '../../data/colecoes';

export async function getStaticPaths() {
  return (await itens('extra')).map((projeto) => ({ params: { slug: projeto.id }, props: { projeto } }));
}

const { projeto } = Astro.props;
const p = projeto.data;
const { Content } = await render(projeto);
---

<Base
  title={p.titulo}
  description={resumir(p.resumo ?? p.chamada ?? p.titulo)}
  trilha={[{ nome: 'Extra', href: '/extra/' }, { nome: p.titulo, href: Astro.url.pathname }]}
  codigo
  diagrama={p.mermaid}
  mermaid={p.mermaid}
>
  <article>
    <div class="hero">
      <p class="eyebrow">Extra{p.periodo && ` · ${p.periodo}`}</p>
      <h1>{p.titulo}</h1>
      {p.chamada && <p class="lede">{p.chamada}</p>}

      {(p.linkCodigo || p.linkSite) && (
        <div class="hero-actions">
          {p.linkSite && <a class="btn btn-solid" href={p.linkSite} target="_blank" rel="noopener">Project site</a>}
          {p.linkCodigo && <a class:list={['btn', !p.linkSite && 'btn-solid']} href={p.linkCodigo} target="_blank" rel="noopener">Source code</a>}
        </div>
      )}
    </div>

    <ul class="publication-facts">
      {p.periodo && <li><span class="k">Year</span><span>{p.periodo}</span></li>}
      {p.situacao && <li><span class="k">Status</span><span class="lang-tag">{p.situacao}</span></li>}
      {p.plataforma && <li><span class="k">Platform</span><span>{p.plataforma}</span></li>}
      {p.feitoCom && <li><span class="k">Built with</span><span>{p.feitoCom}</span></li>}
      {p.feitoJunto && <li><span class="k">Made with</span><span>{p.feitoJunto}</span></li>}
      {/* Os botões do topo somem na impressão: os endereços só chegam ao papel se estiverem escritos aqui. */}
      {p.linkSite && <li><span class="k">Website</span><span><a href={p.linkSite} target="_blank" rel="noopener">{urlCurta(p.linkSite)}</a></span></li>}
      {p.linkCodigo && <li><span class="k">Source</span><span><a href={p.linkCodigo} target="_blank" rel="noopener">{urlCurta(p.linkCodigo)}</a></span></li>}
    </ul>

    {p.resumo && (
      <div class="abstract">
        <h2>About</h2>
        <p>{p.resumo}</p>
      </div>
    )}

    <div class="section prose">
      <Content />
    </div>

    <AnteriorProximo colecao="extra" id={projeto.id} />
  </article>
</Base>
