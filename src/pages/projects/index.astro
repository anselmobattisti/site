---
// Projetos de pesquisa, do mais recente para o mais antigo.
import Base from '../../layouts/Base.astro';
import ListaProjetos from '../../components/ListaProjetos.astro';
import { recentes } from '../../data/colecoes';
---

<Base
  title="Research Projects — Anselmo Luiz Éden Battisti"
  description="Research projects led or co-developed by Anselmo Luiz Éden Battisti in edge computing, network function virtualization and multimedia systems."
  trilha={[{ nome: 'Research', href: '/research/' }, { nome: 'Projects', href: '/projects/' }]}
>
  <div class="hero">
    <h1>Projects</h1>
    <p class="lede">Research projects I lead or take part in, newest first. Where the work is public, the code and the project site are linked.</p>
  </div>

  <ListaProjetos colecao="projects" projetos={await recentes('projects')} vazio="No projects published yet." />
</Base>
